{
  "version": 3,
  "environment": { "background": "#27405c", "ambientIntensity": 0.8 },
  "entities": [
    { "name": "Camera", "position": [0, 2.2, 6], "rotation": [-15, 0, 0], "components": [{ "type": "camera" }] },
    {
      "name": "Sun",
      "position": [3, 6, 4],
      "rotation": [-50, 30, 0],
      "components": [{ "type": "light", "kind": "directional", "castShadow": true }]
    },
    { "name": "Floor", "scale": [12, 1, 12], "components": [{ "type": "mesh", "shape": "plane", "material": "Tiles" }] },
    {
      "name": "Cube",
      "position": [-2.2, 0.8, 0],
      "components": [
        { "type": "mesh", "material": "Bricks" },
        { "type": "script", "script": "spin", "params": { "speed": 45 } },
        { "type": "script", "script": "htmlBadge" }
      ]
    },
    {
      "name": "HUD",
      "components": [{ "type": "canvas" }],
      "children": [
        {
          "name": "Panel",
          "components": [
            { "type": "ui", "anchor": "right", "x": -24, "width": 300, "height": -48 },
            { "type": "image", "color": "#101820", "opacity": 0.85 },
            { "type": "layout", "gap": 10, "padding": 14, "align": "stretch" }
          ],
          "children": [
            {
              "name": "Title",
              "components": [
                { "type": "ui", "height": 30 },
                { "type": "text", "text": "Speed: 45", "size": 20, "align": "left" }
              ]
            },
            {
              "name": "Speed",
              "components": [
                { "type": "ui", "height": 22 },
                { "type": "image", "color": "#2a3b4d" },
                { "type": "slider", "value": 45, "min": 0, "max": 360, "step": 15 },
                { "type": "script", "script": "echo", "params": { "label": "Title", "prefix": "Speed: ", "spin": "Cube" } }
              ]
            },
            {
              "name": "Name",
              "components": [
                { "type": "ui", "height": 34 },
                { "type": "image", "color": "#0a1118" },
                { "type": "text", "size": 18 },
                { "type": "input", "placeholder": "Your name, then Enter", "max": 16 },
                { "type": "script", "script": "echo", "params": { "label": "Greeting", "prefix": "Hello, ", "onSubmit": true } }
              ]
            },
            {
              "name": "Greeting",
              "components": [
                { "type": "ui", "height": 26 },
                { "type": "text", "text": "Hello, ...", "size": 16, "color": "#c8d4e0", "align": "left" }
              ]
            },
            {
