              "components": [
                { "type": "ui", "height": 130 },
                { "type": "image", "color": "#0a1118" },
                { "type": "scroll" },
                { "type": "layout", "gap": 4, "padding": 6, "align": "stretch" }
              ],
              "children": [
                {
                  "name": "Row 1",
                  "components": [
                    { "type": "ui", "width": 0, "height": 28 },
                    { "type": "image", "color": "#1a2c40" },
                    { "type": "text", "text": "Row 1", "size": 16 }
